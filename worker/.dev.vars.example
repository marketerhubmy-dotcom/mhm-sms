# Salin ke worker/.dev.vars untuk pembangunan tempatan. JANGAN commit .dev.vars.
# Nilai kosong = tidak digunakan. Secrets production ditetapkan dengan `wrangler secret put`.
# Mod demo (lalai) tidak memerlukan sebarang secret.

# --- Hanya jika menguji adapter sebenar secara tempatan (staging/sandbox sahaja) ---
# APP_ENV=staging
# SMS_PROVIDER=onlinesim
# PAYMENT_PROVIDER=chip
ONLINESIM_API_KEY=
ONLINESIM_WEBHOOK_TOKEN=
CHIP_SECRET_KEY=
CHIP_BRAND_ID=
RESEND_API_KEY=
EMAIL_FROM=
LIVE_PURCHASES_ENABLED=false
LIVE_PAYMENTS_ENABLED=false
